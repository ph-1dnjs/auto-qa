{
  "name": "autoqa-desktop",
  "version": "0.1.0",
  "description": "URL-based client QA automation desktop app for macOS and Windows.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "install:browsers": "node scripts/install-browsers.js",
    "prebuild": "npm run install:browsers",
    "prebuild:mac": "npm run install:browsers",
    "prebuild:win": "npm run install:browsers",
    "build": "electron-builder --mac --win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "electron"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "playwright": "^1.51.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.autoqa.desktop",
    "productName": "AutoQA",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "playwright-browsers"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
