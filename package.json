{
  "name": "autoqa-desktop",
  "version": "0.1.1",
  "description": "URL-based client QA automation desktop app for macOS and Windows.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "install:browsers": "node scripts/install-browsers.js",
    "release:prepare": "node scripts/prepare-release.js",
    "prebuild": "npm run install:browsers",
    "prebuild:mac": "npm run install:browsers",
    "prebuild:win": "npm run install:browsers",
    "prebuild:win:x64": "npm run install:browsers",
    "prebuild:win:arm64": "npm run install:browsers",
    "build": "electron-builder --mac --win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:win:x64": "electron-builder --win --x64",
    "build:win:arm64": "electron-builder --win --arm64",
    "build:all": "npm run build:mac && npm run build:win:x64 && npm run build:win:arm64",
    "prepublish:mac": "npm run install:browsers",
    "publish:mac": "electron-builder --mac --publish always",
    "prepublish:win:x64": "npm run install:browsers",
    "prepublish:win:arm64": "npm run install:browsers",
    "publish:win:x64": "electron-builder --win --x64 --publish always",
    "publish:win:arm64": "electron-builder --win --arm64 --publish always",
    "publish:all": "npm run publish:mac && npm run publish:win:x64 && npm run publish:win:arm64"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "electron"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "playwright": "^1.51.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.autoqa.desktop",
    "productName": "AutoQA",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "playwright-browsers"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName} ${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ph-1dnjs",
        "repo": "auto-qa",
        "releaseType": "release"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  }
}
